---
import '@fontsource/jost/300.css';
import '@fontsource/jost/400.css';
import '@fontsource/jost/500.css';
import '@fontsource/jost/600.css';
import '@fontsource/mrs-saint-delafield/400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icons from '../components/Icons.astro';
import contact from '../data/contact.json';

interface Props {
  title?: string;
  description?: string;
  current: 'home' | 'designs' | 'contact';
}

const { title, description, current } = Astro.props;
const fullTitle = title ? `${title} · ${contact.business}` : `${contact.business} · Custom full-sublimation teamwear, ${contact.city}`;
const metaDescription =
  description ??
  `${contact.business} (${contact.alsoKnownAs}) makes custom full-sublimation jerseys and teamwear for teams, schools and organizations in ${contact.city}. Start your order on Messenger.`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="theme-color" content="#012c95" />
    <link rel="icon" type="image/png" href="/images/logos/logo-om.png" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Icons />
    <Header current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
