---
import packageData from '../data/packages.json';
import productData from '../data/products.json';
import contact from '../data/contact.json';
import images from '../data/images.json';

type Img = { src: string; width: number; height: number; alt: string };
const pkgImages = images.packages as unknown as Record<string, Img | string>;
const cards = packageData.packages.map((p) => {
  const img = pkgImages[p.id];
  return { ...p, img: typeof img === 'object' ? img : undefined };
});

const fmt = (n: number) => `${packageData.currency}${n.toLocaleString('en-PH')}`;
---
{packageData.showPrices && (
  <section class="pk" id="packages" aria-labelledby="packages-title">
    <div class="wrap">
      <div class="head">
        <div>
          <i class="rule"></i>
          <h2 id="packages-title" class="h2">Packages <b>&amp; prices</b></h2>
        </div>
        <p class="label tag">{packageData.label}</p>
      </div>

      <ol class="grid">
        {cards.map((p) => (
          <li class="pkg">
            {p.img && (
              <div class="frame">
                <img src={p.img.src} width={p.img.width} height={p.img.height} alt={p.img.alt} loading="lazy" decoding="async" />
              </div>
            )}
            <h3 class="name">{p.name}<span> package</span></h3>
            <p class="price">{fmt(p.price)}</p>
            <ul class="inc">
              {p.includes.map((item) => <li>{item}</li>)}
            </ul>
            {p.note && <p class="note">{p.note}</p>}
            <a class="tlink" href={contact.messenger.url} target="_blank" rel="noopener">
              Ask about {p.name}<svg class="i"><use href="#i-arrow" /></svg>
            </a>
          </li>
        ))}
      </ol>

      <div class="pieces">
        <h3 class="label">Per piece</h3>
        <ul>
          {productData.products.map((p) => (
            <li><span>{p.priceLabel}</span><b>{fmt(p.price)}</b></li>
          ))}
        </ul>
      </div>
    </div>
  </section>
)}

<style>
  .pk { padding-top: 112px; }
  .head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; margin-bottom: 40px; }
  .tag { color: var(--blue); padding-bottom: 6px; }

  .grid {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 56px;
    border-top: 1px solid var(--ink);
  }
  .pkg {
    display: grid; grid-template-rows: auto auto auto 1fr auto auto; align-content: start;
    padding: 32px 0 36px;
    border-bottom: 1px solid var(--line);
  }
  .frame {
    aspect-ratio: 800 / 908; overflow: hidden; margin-bottom: 26px;
    box-shadow: 0 24px 44px -30px rgba(1, 20, 70, .45);
    transition: box-shadow .5s var(--ease), transform .5s var(--ease);
  }
  .frame img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s var(--ease); }
  .pkg:hover .frame { transform: translateY(-4px); box-shadow: 0 34px 56px -30px rgba(1, 20, 70, .55); }
  .pkg:hover .frame img { transform: scale(1.03); }
  .name { font: 500 15px/1.3 var(--f-sans); letter-spacing: .14em; text-transform: uppercase; }
  .name span { color: var(--muted); font-weight: 400; }
  .price {
    margin: 14px 0 20px;
    font: 300 64px/1 var(--f-sans); letter-spacing: -.01em; color: var(--blue);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .inc { display: grid; align-content: start; gap: 6px; font: 400 15.5px/1.45 var(--f-sans); color: var(--ink); }
  .inc li + li::before { content: '+ '; color: var(--muted); }
  .note { margin-top: 12px; font: 400 14px/1.4 var(--f-sans); color: var(--muted); }
  .pkg .tlink { justify-self: start; margin-top: 26px; font-size: 11.5px; }

  .pieces {
    margin-top: 40px; display: grid; grid-template-columns: 160px 1fr; gap: 24px; align-items: baseline;
  }
  .pieces h3 { color: var(--muted); }
  .pieces ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 40px; }
  .pieces li {
    display: flex; justify-content: space-between; align-items: baseline; gap: 16px;
    padding: 12px 0; border-bottom: 1px solid var(--line);
    font: 400 15.5px/1.3 var(--f-sans);
  }
  .pieces b { font-weight: 500; letter-spacing: .02em; font-variant-numeric: tabular-nums; }

  @media (max-width: 1100px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 40px; }
    .pieces { grid-template-columns: 1fr; }
    .pieces ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .head { flex-direction: column; align-items: flex-start; }
    .grid { grid-template-columns: 1fr; }
    .price { font-size: 52px; }
    .pieces ul { grid-template-columns: 1fr; }
  }
</style>
