---
import contact from '../data/contact.json';
import images from '../data/images.json';

interface Props { current: 'home' | 'designs' | 'contact'; }
const { current } = Astro.props;
const mark = images.logos.mark;

const nav = [
  { id: 'home', label: 'Home', href: '/' },
  { id: 'designs', label: 'Browse Designs', href: '/designs/' },
  { id: 'shop', label: 'Shop', href: contact.shop.url, external: true },
  { id: 'contact', label: 'Contact', href: '/contact/' },
];
---
<div class="util">
  <span>Full-sublimation teamwear · {contact.city}</span>
  <a href={`tel:${contact.phone.tel}`}><svg class="i"><use href="#i-phone" /></svg>Call {contact.phone.display}</a>
  <a href={contact.shop.url} target="_blank" rel="noopener">Shop at {contact.shop.display}<svg class="i"><use href="#i-out" /></svg></a>
</div>

<header class="nav">
  <a class="brand" href="/" aria-label={`${contact.business} home`}>
    <img class="om" src={mark.src} width={mark.width} height={mark.height} alt="" />
    <span class="wm">{contact.business}</span>
  </a>
  <nav aria-label="Main">
    <ul>
      {nav.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={item.id === current ? 'page' : undefined}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener' : undefined}
          >
            {item.label}
            {item.external && <span class="sr">(opens ondmoveshop.com)</span>}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <a class="cta" href={contact.messenger.url} target="_blank" rel="noopener">Order on Messenger</a>
</header>

<style>
  .util {
    height: 32px; background: var(--black); color: #e9e9e9;
    display: flex; justify-content: space-around; align-items: center;
    font: 400 12.5px/1 var(--f-sans); letter-spacing: .04em;
  }
  .util a, .util span { display: inline-flex; align-items: center; gap: 8px; }
  .util :global(svg.i) { width: 14px; height: 14px; }
  .util a:hover { color: #fff; text-decoration: underline; text-underline-offset: 3px; }

  .nav {
    height: 68px; display: flex; align-items: center; gap: 14px;
    padding: 0 var(--gutter); max-width: var(--max); margin: 0 auto;
    background: var(--white);
  }
  .brand { display: inline-flex; align-items: center; gap: 14px; }
  .om { height: 30px; width: auto; }
  .wm { font: 500 15px/1 var(--f-sans); letter-spacing: .22em; text-transform: uppercase; }
  nav { margin: 0 auto; }
  nav ul { display: flex; gap: 44px; font: 400 13px/1 var(--f-sans); letter-spacing: .16em; text-transform: uppercase; }
  nav a { display: inline-block; padding: 8px 0; border-bottom: 1.5px solid transparent; transition: border-color .2s, color .2s; }
  nav a:hover, nav a[aria-current] { border-color: var(--red); color: var(--red); }
  .cta {
    font: 500 12.5px/1 var(--f-sans); letter-spacing: .14em; text-transform: uppercase;
    padding: 12px 16px; border: 1px solid var(--ink); transition: background-color .2s, color .2s;
  }
  .cta:hover { background: var(--ink); color: var(--white); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (max-width: 1100px) {
    nav ul { gap: 26px; }
    .wm { display: none; }
  }
  @media (max-width: 760px) {
    .util { justify-content: space-between; padding: 0 var(--gutter); }
    .util span { display: none; }
    .nav { height: auto; flex-wrap: wrap; padding-top: 14px; padding-bottom: 6px; }
    .cta { margin-left: auto; padding: 10px 12px; }
    nav { order: 3; width: 100%; margin: 6px 0 0; overflow-x: auto; }
    nav ul { gap: 22px; font-size: 12px; }
  }
</style>
